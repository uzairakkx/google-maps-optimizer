APP_ENV=development
APP_NAME=google-maps-optimizer-api
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Required by the API and Celery worker.
DATABASE_URL=postgresql+asyncpg://gmo:gmo@postgres:5432/google_maps_optimizer
REDIS_URL=redis://redis:6379/0

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:3000

# Used by the frontend API client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1